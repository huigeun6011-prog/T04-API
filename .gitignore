.env
.kilo

# Python
__pycache__/
*.pyc
.venv/

# 대용량 생성물 (GitHub 100MB 제한). 재생성 방법은 docs/HANDOFF.md 참고
outputs/ground_truth_train_loads.csv
outputs/diagnostics/candidate_training/*.csv
outputs/backup_before_rebuild_*/

# 이전 PyTorch 모델 (현재 공식 추론 파일은 load_predictor.joblib)
outputs/best_model.pt

# 로컬 전용 키 설정
web/config.local.js

# 로컬 전용 Claude 설정과 외부 스킬 (내 PC 경로가 들어 있고 서드파티 자료 3MB)
.claude/

# OD 라벨 표본 실행의 재생성 가능한 대용량 산출물 (make_od_labels.py로 다시 만든다)
outputs/diagnostics/od_labels/*/labels/
outputs/diagnostics/od_labels/*/dataset.csv

# 항저우 태그 원본 자료(대용량, 외부 자료)와 중간 산출물
data/external/
outputs/hangzhou/cache/

# 교체 전 production 백업 (교체 전 파일은 git 이력에도 있음)
outputs/backup_before_od_swap_*/
